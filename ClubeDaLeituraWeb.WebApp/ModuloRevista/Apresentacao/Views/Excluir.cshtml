@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Revista";
}

@model ExcluirRevistaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Deseja realmente excluir esta revista?
    </div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Título</label>
        <input asp-for="Titulo" type="text" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroEdicao" class="form-label fw-semibold text-primary text-uppercase small">Número da Edição</label>
        <input asp-for="NumeroEdicao" type="number" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label asp-for="AnoPublicacao" class="form-label fw-semibold text-primary text-uppercase small">Ano de Publicação</label>
        <input asp-for="AnoPublicacao" type="number" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label asp-for="CaixaEtiqueta" class="form-label fw-semibold text-primary text-uppercase small">Caixa</label>
        <input asp-for="CaixaEtiqueta" type="text" class="form-control" disabled>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
